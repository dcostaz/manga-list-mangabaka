{
  "compilerOptions": {
    "outDir": "./dist",
    "checkJs": true,
    "allowJs": true,
    "baseUrl": ".",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": [
      "es2019"
    ],
    "types": [
      "node"
    ],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "**/types/*.d.ts",
    "**/types/**/*.d.ts",
    "**/*.js",
    "**/*.cjs",
    "**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests",
    "scripts"
  ]
}
